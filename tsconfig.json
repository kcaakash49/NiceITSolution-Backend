{
  "compilerOptions": {
    "target": "ES2022",                  // Modernized for Node 18+
    "module": "NodeNext",                // Tells tsc to output ESM valid for Node
    "moduleResolution": "NodeNext",      // Forces TS to check for proper ESM extensions
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}